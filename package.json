{
  "name": "pincel",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "e2e:pwa": "vite build && playwright test -c playwright.pwa.config.ts",
    "proxy": "node server/standalone.ts",
    "jev:models": "node scripts/jev-models.mjs",
    "jev:calibrate": "JEV_CALIBRATE=1 vitest run src/recognition/ai/calibrate.test.ts",
    "jev:calibrate:mock": "JEV_CALIBRATE=mock vitest run src/recognition/ai/calibrate.test.ts"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "perfect-freehand": "^1.2.3",
    "preact": "^11.1.1",
    "roughjs": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
