# ===== Desenvolvimento: copie para .env.local (ignorado pelo git) =====
# A chave NUNCA vai ao navegador: o proxy roda dentro do `npm run dev`.
TYPESAFE_API_KEY=
# Modelo pinado (opcional). Confira os disponíveis com `npm run jev:models`.
# JEV_MODEL=jev-1.13.0

# ===== Produção (VPS): crie `.env.production` na pasta do projeto (ignorado pelo git) =====
# É lido pelo docker-compose.yml (container pincel_proxy). Conteúdo mínimo:
#   TYPESAFE_API_KEY=...
#   JEV_MODEL=jev-1.13.0            (opcional)
#   RATE_LIMIT_PER_MIN=40           (por visitante)
#   GLOBAL_RATE_LIMIT_PER_MIN=600   (soma de todos; protege o custo da chave)
# TRUST_PROXY=1 já vem no docker-compose.yml (o nginx escreve o X-Forwarded-For).
# O app é construído pelo ./rebuild.sh com VITE_AI_ENDPOINT=/api/shape (mesma origem, sem CORS).
#
# Outros cenários (proxy em outro domínio): VITE_AI_ENDPOINT=https://proxy.exemplo.com/api/shape no build
# e ALLOWED_ORIGIN=https://app.exemplo.com no proxy.
